digraph release {
  rankdir=LR;
  bgcolor="transparent";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#555555", fillcolor="#f4f4f4"];
  edge [fontname="Helvetica", fontsize=10, color="#555555"];

  pr     [label="Pull request\n(human or agent)"];
  gate   [label="Automated gate\nfmt · vet · lint\ntest · race", fillcolor="#e3eefb", color="#2b6cb0"];
  review [label="Independent review\nat this exact commit", fillcolor="#e3eefb", color="#2b6cb0"];
  human  [label="Human approves\nand merges", fillcolor="#e3eefb", color="#2b6cb0"];
  tag    [label="Tag vX.Y.Z"];
  build  [label="Build once\nversion from the tag"];
  deploy [label="Deploy"];
  smoke  [label="Smoke test", fillcolor="#e6f4ea", color="#2f855a"];
  roll   [label="Roll back to the\nprevious artifact", fillcolor="#fdf1e3", color="#c05621"];

  pr -> gate -> review -> human -> tag -> build -> deploy -> smoke;
  gate -> pr   [label="fail", color="#c05621", fontcolor="#c05621", constraint=false];
  review -> pr [label="changes", color="#c05621", fontcolor="#c05621", constraint=false];
  smoke -> roll [label="fail", color="#c05621", fontcolor="#c05621"];
}
